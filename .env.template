# RawrZ Security Platform - Environment Configuration Template
# Copy this file to .env and update the values as needed

# Application Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_SECRET=your-jwt-secret-here-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-this-in-production

# Database Configuration (if using external database)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rawrz_security
# DB_USER=rawrz_user
# DB_PASSWORD=your-database-password-here

# Redis Configuration (if using Redis for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password-here

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/app/logs/rawrz.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_DIR=/app/uploads
TEMP_DIR=/app/temp

# Network Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ENABLED=true

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Features
ANTI_ANALYSIS_ENABLED=true
STEALTH_MODE_ENABLED=true
POLYMORPHIC_ENGINE_ENABLED=true
MEMORY_PROTECTION_ENABLED=true

# Monitoring and Health Checks
HEALTH_CHECK_INTERVAL=30000
MONITORING_ENABLED=true
METRICS_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/app/backups

# DigitalOcean Specific Configuration
DO_API_TOKEN=your-digitalocean-api-token-here
DO_REGION=nyc1
DO_DROPLET_SIZE=s-1vcpu-1gb

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=RawrZ Security Platform <noreply@yourdomain.com>

# Webhook Configuration (for external integrations)
# WEBHOOK_URL=https://your-webhook-endpoint.com/rawrz
# WEBHOOK_SECRET=your-webhook-secret

# Development/Testing (set to false in production)
DEBUG=false
VERBOSE_LOGGING=false
TEST_MODE=false