{
  "name": "carmilla-todo-system",
  "version": "1.0.0",
  "description": "Encrypted Todo Application with Carmilla OpenSSL encryption, in-memory patching, and selective area encryption",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "start": "node dist/api/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.{ts,tsx}",
    "check-openssl": "openssl version || echo 'OpenSSL not installed'"
  },
  "keywords": [
    "encryption",
    "openssl",
    "todo",
    "carmilla",
    "security",
    "typescript",
    "react"
  ],
  "author": "ItsMehRAWRXD",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.2.0",
    "vite": "^4.4.0",
    "ts-node-dev": "^2.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.5"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}