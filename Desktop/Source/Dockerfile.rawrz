# Use Ubuntu as base image for OpenSSL support
FROM ubuntu:22.04 as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy RawrZ source files
COPY RawrZ_Dev/RawrZ_Dev/RawrZ_Simple_OpenSSL.cpp ./
COPY RawrZ_Dev/RawrZ_Dev/RawrZOpenSSLStub.cpp ./
COPY RawrZ_Dev/RawrZ_Dev/RawrZRealOpenSSL.cpp ./

# Create CMakeLists.txt for building
RUN echo 'cmake_minimum_required(VERSION 3.10)\n\
project(RawrZ)\n\
\n\
set(CMAKE_CXX_STANDARD 17)\n\
set(CMAKE_CXX_STANDARD_REQUIRED ON)\n\
\n\
find_package(OpenSSL REQUIRED)\n\
\n\
add_library(rawrz SHARED\n\
    RawrZ_Simple_OpenSSL.cpp\n\
    RawrZOpenSSLStub.cpp\n\
    RawrZRealOpenSSL.cpp\n\
)\n\
\n\
target_link_libraries(rawrz OpenSSL::SSL OpenSSL::Crypto)\n\
\n\
install(TARGETS rawrz\n\
    LIBRARY DESTINATION lib\n\
    RUNTIME DESTINATION bin\n\
)' > CMakeLists.txt

# Build the library
RUN mkdir build && cd build && \
    cmake .. && \
    make && \
    make install

# Create runtime image
FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy built library from builder
COPY --from=builder /usr/local/lib/librawrz.so /usr/local/lib/
RUN ldconfig

# Create directory for uploads
RUN mkdir -p /app/uploads && chmod 777 /app/uploads

# Set working directory
WORKDIR /app

# Command to keep container running (will be overridden by k8s/docker-compose)
CMD ["tail", "-f", "/dev/null"]
