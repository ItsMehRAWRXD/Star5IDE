# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# SaaS Encryption Platform - Netlify Deployment
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=8888

# =============================================================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# =============================================================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Get your connection string from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/saas-encryption

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a strong random string (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# STRIPE PAYMENT PROCESSING
# =============================================================================
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# =============================================================================
# EMAIL SERVICE (SendGrid)
# =============================================================================
# Get these from your SendGrid Dashboard: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_USERNAME=your_sendgrid_username
EMAIL_FROM=noreply@yourcompany.com
EMAIL_FROM_NAME=SaaS Encryption Platform

# =============================================================================
# FRONTEND & CORS
# =============================================================================
# Your Netlify app URL after deployment
FRONTEND_URL=https://your-app-name.netlify.app
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-app-name.netlify.app,https://yourdomain.com

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
# Rate limiting configuration (in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SLOW_DOWN_WINDOW_MS=900000
SLOW_DOWN_DELAY_AFTER=100
SLOW_DOWN_DELAY_MS=500

# =============================================================================
# ENCRYPTION CONFIGURATION
# =============================================================================
# Supported algorithms: aes-256-gcm, aes-256-cbc, aes-192-gcm, aes-192-cbc
ENCRYPTION_ALGORITHM=aes-256-gcm
# Supported hash algorithms: sha256, sha512, sha384, sha1
HASH_ALGORITHM=sha256
# Key length in bits (128, 192, 256 for AES)
KEY_LENGTH=256

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_VERSION=v1
API_PREFIX=/api

# =============================================================================
# NETLIFY SPECIFIC
# =============================================================================
# Netlify will automatically set these in production
# NETLIFY_DEV=true
# NETLIFY_CONTEXT=deploy-preview
