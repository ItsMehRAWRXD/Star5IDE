# Panel Environment Variables for lionfish-app integration
NODE_ENV=production
PORT=3000
DOMAIN=lionfish-app-ey7kn.ondigitalocean.app
PANEL_PATH=/panel
BASE_URL=https://lionfish-app-ey7kn.ondigitalocean.app

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/rawrz_panel
DB_NAME=rawrz_panel

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this
JWT_EXPIRES_IN=24h

# Email Configuration (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/lionfish-app-ey7kn.ondigitalocean.app.crt
SSL_KEY_PATH=/etc/nginx/ssl/lionfish-app-ey7kn.ondigitalocean.app.key

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs/panel.log

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads

# CORS Configuration
CORS_ORIGIN=https://lionfish-app-ey7kn.ondigitalocean.app
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=your-session-secret-key-here-change-this
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true

# Monitoring Configuration
ENABLE_MONITORING=true
MONITORING_PORT=9090

# Feature Flags
ENABLE_CRYPTO_ENGINES=true
ENABLE_DUAL_ENCRYPTION=true
ENABLE_HOT_PATCHING=true
ENABLE_PROCESS_MONITORING=true

# Panel-specific settings
PANEL_TITLE=RawrZ Security Platform
PANEL_DESCRIPTION=Advanced Security Tools and Crypto Engines
PANEL_ICON=🛡️
PANEL_THEME=dark
