{
  "manifest_version": 3,
  "name": "Secure AI Desktop Helper",
  "version": "2.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.openai.com/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "content_v2.js"]
    }
  ],
  "side_panel": {
    "default_path": "chatbox.html"
  }
}
