{
  "name": "ai-copilot-ide",
  "version": "1.0.0",
  "description": "AI Co-Pilot for Custom IDE - Intelligent coding assistant",
  "main": "src/background/background.js",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "package": "webpack --mode=production && zip -r ai-copilot.zip dist/",
    "clean": "rm -rf dist/",
    "start": "npm run dev"
  },
  "keywords": [
    "ai",
    "copilot",
    "ide",
    "assistant",
    "openai",
    "coding",
    "development"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.20.1",
    "crypto-js": "^4.2.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "@types/chrome": "^0.0.251"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ai-copilot-ide.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/ai-copilot-ide/issues"
  },
  "homepage": "https://github.com/yourusername/ai-copilot-ide#readme"
}
