# RawrZ Security Platform - Production Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security Settings - CHANGE THESE IN PRODUCTION!
SECRET_KEY=rawrz-security-platform-2024-production-key
JWT_SECRET=rawrz-jwt-secret-2024-production
ENCRYPTION_KEY=rawrz-encryption-key-2024-production

# File Upload Settings
MAX_FILE_SIZE=100MB
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=.exe,.dll,.txt,.pdf,.zip,.rar,.7z,.enc,.hash,.key

# Logging Settings
LOG_LEVEL=info
LOG_FILE=/app/logs/rawrz.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Network Settings
ALLOWED_IPS=0.0.0.0/0
RATE_LIMIT=100
RATE_WINDOW=900000

# SSL/TLS Settings
FORCE_HTTPS=true

# Monitoring Settings
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Backup Settings
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups