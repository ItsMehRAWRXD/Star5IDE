# RawrZ Security Platform - Environment Configuration
# Copy this file to .env and modify the values as needed

# Application Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security Settings
SECRET_KEY=your-secret-key-here-change-this
JWT_SECRET=your-jwt-secret-here-change-this
ENCRYPTION_KEY=your-encryption-key-here-change-this

# Database Settings (if using external database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rawrz_security
DB_USER=rawrz_user
DB_PASSWORD=your-db-password-here

# Redis Settings (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here

# File Upload Settings
MAX_FILE_SIZE=100MB
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=.exe,.dll,.txt,.pdf,.zip,.rar,.7z

# Logging Settings
LOG_LEVEL=info
LOG_FILE=/app/logs/rawrz.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Network Settings
ALLOWED_IPS=0.0.0.0/0
BLOCKED_IPS=
RATE_LIMIT=100
RATE_WINDOW=900000

# SSL/TLS Settings
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
FORCE_HTTPS=true

# Monitoring Settings
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
METRICS_PORT=9090

# Backup Settings
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups