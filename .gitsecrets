# Git Secrets Patterns
# This file contains patterns for git-secrets to detect

# DigitalOcean tokens
dop_v1_[a-f0-9]{64}

# GitHub tokens
ghp_[A-Za-z0-9]{36}
gho_[A-Za-z0-9]{36}
ghs_[A-Za-z0-9]{36}
github_pat_[A-Za-z0-9]{22}_[A-Za-z0-9]{59}

# AWS keys
AKIA[0-9A-Z]{16}
aws_access_key_id
aws_secret_access_key

# Stripe keys
sk_live_[A-Za-z0-9]{24}
sk_test_[A-Za-z0-9]{24}
rk_live_[A-Za-z0-9]{24}
rk_test_[A-Za-z0-9]{24}

# Generic API keys
api[_-]?key[_-]?[=:]\s*['"][A-Za-z0-9]{32,}['"]
secret[_-]?key[_-]?[=:]\s*['"][A-Za-z0-9]{32,}['"]
token[_-]?[=:]\s*['"][A-Za-z0-9]{32,}['"]

# Private keys
-----BEGIN RSA PRIVATE KEY-----
-----BEGIN EC PRIVATE KEY-----
-----BEGIN PRIVATE KEY-----
-----BEGIN PGP PRIVATE KEY BLOCK-----
-----BEGIN DSA PRIVATE KEY-----
-----BEGIN OPENSSH PRIVATE KEY-----