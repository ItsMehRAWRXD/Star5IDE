{
  "name": "hello-world-ext",
  "displayName": "Hello World Ext",
  "version": "0.0.1",
  "publisher": "you",
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": [ "onCommand:hello.sayHello" ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hello.sayHello",
        "title": "Hello: Say Hello"
      }
      ,
      {
        "command": "carmilla.generateAndEncryptStub",
        "title": "Camellia: Generate + Encrypt Stub"
      }
      ,
      {
        "command": "carmilla.generateAndEncryptStubToAny",
        "title": "Camellia: Generate + Encrypt Stub To Any File"
      }
      ,
      {
        "command": "carmilla.packageTextAndFilesToAny",
        "title": "Camellia: Package Text & Files To Any File"
      }
      ,
      {
        "command": "carmilla.packageByExtensionToAny",
        "title": "Camellia: Package *.extension Type + Files To Any File"
      }
    ]
  },
  "scripts": {
    "build": "echo 'No TypeScript build'",
    "watch": "echo 'No TypeScript watch'",
    "test": "echo \"(optional)\"",
    "start": "node server/encrypt_server.js"
  },
  "devDependencies": {}
}
