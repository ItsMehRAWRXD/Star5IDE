{
  "name": "droplet-forge",
  "version": "1.0.0",
  "description": "🔨 Bulletproof DigitalOcean Droplet deployment - destroy and rebuild identical servers in 60 seconds",
  "keywords": [
    "digitalocean",
    "droplet",
    "deployment",
    "devops",
    "cloud-init",
    "infrastructure",
    "iaas",
    "server",
    "automation",
    "docker",
    "nodejs",
    "pm2"
  ],
  "homepage": "https://github.com/YOUR_USERNAME/droplet-forge",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/droplet-forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/droplet-forge.git"
  },
  "license": "MIT",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "scripts": {
    "deploy": "./deploy.sh",
    "rebuild": "./scripts/destroy-and-rebuild.sh",
    "health": "./scripts/health-check.sh",
    "backup": "./scripts/backup.sh",
    "ssl": "./scripts/setup-ssl.sh",
    "validate": "./scripts/validate.sh",
    "validate:secrets": "git secrets --scan",
    "validate:yaml": "yamllint -d relaxed .",
    "validate:shell": "shellcheck *.sh scripts/*.sh",
    "prepare": "husky install",
    "pre-commit": "npm run validate"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}