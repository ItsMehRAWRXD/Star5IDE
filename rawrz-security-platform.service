[Unit]
Description=RawrZ Security Platform
Documentation=https://github.com/yourusername/rawrz-security-platform
Requires=docker.service
After=docker.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rawrz-security-platform
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
User=rawrz
Group=rawrz

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rawrz-security-platform

# Environment
Environment=NODE_ENV=production
Environment=COMPOSE_PROJECT_NAME=rawrz-security

[Install]
WantedBy=multi-user.target